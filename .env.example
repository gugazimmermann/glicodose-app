# Copie este arquivo para .env e preencha com os valores do seu projeto.
# NÃO commite o arquivo .env (ele está no .gitignore).
#
# Uso:
#   cp .env.example .env
#   flutter run --dart-define-from-file=.env
#
# Valores: Supabase → Project Settings → API

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# NÃO coloque OPENAI_API_KEY aqui.
# A chave da OpenAI fica só no Supabase:
#   supabase secrets set OPENAI_API_KEY=sk-...
