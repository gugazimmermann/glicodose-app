<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis=1800000 (30 min) is the Android OS minimum for system
  wakeups. Minute-level Libre sync is handled by the Flutter foreground
  service / Workmanager — this is only a coarse fallback when those die.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="app.glicodose.GlicoDoseWidgetConfigureActivity"
    android:description="@string/glicodose_widget_description"
    android:initialLayout="@layout/glicodose_widget"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
